# Configuration is by environment variables: the full list is in docs/api.md. Copy this to .env for local use.
PLINTH_LISTEN_ADDR=:8080
PLINTH_DATABASE_URL=postgres://plinth:plinth@localhost:5432/plinth?sslmode=disable
# Generate with: ./bin/plinth genkey   (inject from a secret manager in production)
PLINTH_MASTER_KEY=

# The first administrator, created at start on a fresh installation. They must choose a new password at first sign-in.
# Leave the password out and run `plinth bootstrap-admin` instead if you prefer.
PLINTH_BOOTSTRAP_ADMIN_USERNAME=admin
PLINTH_BOOTSTRAP_ADMIN_PASSWORD=

# Identity providers are normally added in the control panel (Sign-in). One can also be fixed here (both or neither):
# PLINTH_OIDC_ISSUER=https://idp.example.com
# PLINTH_OIDC_AUDIENCE=plinth
# PLINTH_ADMIN_GROUP=plinth-admins

PLINTH_WORKERS=2
